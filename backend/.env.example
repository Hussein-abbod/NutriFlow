# Copy to .env and fill in real values. Never commit .env.

# MySQL connection (dev). Tests use in-memory SQLite or TEST_DATABASE_URL.
DATABASE_URL=mysql+pymysql://root:change-me@localhost:3306/nutriflow

# JWT â€” SECRET_KEY must be at least 32 random characters
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-random-hex-string-000000000000000000000000
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API with credentials. Never "*".
# Open the web app on the SAME host name as VITE_API_BASE_URL (localhost vs 127.0.0.1 are
# different sites, so the SameSite=strict refresh cookie would not be sent).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Refresh-token cookie for web clients. Browsers accept Secure cookies on http://localhost,
# but NOT on a plain-http LAN IP (phone testing): use HTTPS there, or set SECURE=false locally.
REFRESH_COOKIE_NAME=nf_refresh
REFRESH_COOKIE_SECURE=true
# strict | lax | none  (use "none" only if the web app and API are on different sites, with HTTPS)
REFRESH_COOKIE_SAMESITE=strict

RATE_LIMIT_ENABLED=true

# External APIs
USDA_API_KEY=DEMO_KEY
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
